# MemOS MCP Server Configuration
# Copy this to .env and customize

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Default: sqlite (for local development)
MEMOS_DB_TYPE=sqlite
MEMOS_DB_PATH=./data/memory.db

# PostgreSQL (shared with Omega_KG_stable)
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5800
# POSTGRES_DB=omega_kg_stable
# POSTGRES_USER=omega_user
# POSTGRES_PASSWORD=your_password_here

# =============================================================================
# REDIS CONFIGURATION (coming soon)
# =============================================================================
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# =============================================================================
# NEO4J CONFIGURATION (Mirmir Bridge - shared with Omega_KG_stable)
# =============================================================================
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password_here

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
FASTMCP_SERVER_HOST=0.0.0.0
FASTMCP_SERVER_PORT=8768
FASTMCP_SERVER_LOG_LEVEL=INFO
FASTMCP_SERVER_TRANSPORT=sse

# =============================================================================
# FEATURE FLAGS
# =============================================================================
MEMOS_ENABLE_TOOL_REGISTRY=true
MEMOS_ENABLE_GRAPH_MEMORY=false
MEMOS_MAX_MEMORY_SIZE=1000
